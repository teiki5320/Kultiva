// Publication de kultiva.toakeur.com sur Cloudflare (dossier landing/).
// GitHub Pages ne sert plus un dépôt privé : depuis le 04/11 le site est publié par `npx wrangler deploy`.
{
  "name": "kultiva-site",
  "compatibility_date": "2026-09-26",
  "assets": { "directory": "./landing", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kultiva.toakeur.com/*", "zone_name": "toakeur.com" }]
}
